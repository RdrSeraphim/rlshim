[Desktop Entry]
Type=Application
Terminal=false
Name=RuneLite
GenericName=RuneLite
Comment=Old School RuneScape Launcher
Keywords=games;
Exec=rlshim
Icon=rlshim
Categories=Game;
StartupWMClass=RuneLite
Actions=ClearSavedChar;

[Desktop Action ClearSavedChar]
Name=Choose Character (Clear Default)
Exec=rlshim --clear-saved-char